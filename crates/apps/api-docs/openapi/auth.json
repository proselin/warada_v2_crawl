{
  "openapi": "3.1.0",
  "info": {
    "title": "Auth Service API",
    "version": "0.1.0",
    "description": "Axum/Tokio authentication service. Manages users and OAuth clients, issues RS256 access tokens, and verifies tokens for downstream services.\n\nManagement endpoints require `Authorization: Bearer $AUTH_ADMIN_API_KEY`."
  },
  "servers": [
    { "url": "http://127.0.0.1:8081", "description": "Local default (AUTH_ADDR)" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Verify" },
    { "name": "Users", "description": "Admin-only user lifecycle" },
    { "name": "Service Clients", "description": "Admin-only service client lifecycle" },
    { "name": "Public Clients", "description": "PKCE client registration" },
    { "name": "OAuth" }
  ],
  "components": {
    "securitySchemes": {
      "adminApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Admin API key supplied as `Authorization: Bearer $AUTH_ADMIN_API_KEY`."
      },
      "accessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "RS256 access token issued by this service."
      }
    },
    "schemas": {
      "UserView": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "active": { "type": "boolean" },
          "created_at": { "type": "integer", "format": "int64", "description": "Unix seconds" }
        },
        "required": ["id", "email", "active", "created_at"]
      },
      "CreateUser": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "description": "At least 12 bytes", "minLength": 12 }
        },
        "required": ["email", "password"]
      },
      "UpdateUser": {
        "type": "object",
        "description": "At least one field must be present.",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 12 },
          "active": { "type": "boolean" }
        }
      },
      "ClientView": {
        "type": "object",
        "properties": {
          "client_id": { "type": "string" },
          "scopes": { "type": "string", "description": "Space-separated scopes" },
          "active": { "type": "boolean" },
          "created_at": { "type": "integer", "format": "int64" }
        },
        "required": ["client_id", "scopes", "active", "created_at"]
      },
      "CreateClient": {
        "type": "object",
        "properties": {
          "client_id": { "type": "string", "minLength": 3, "maxLength": 100, "description": "Alphanumeric plus - _ ." },
          "scopes": { "type": "array", "items": { "type": "string" }, "description": "Defaults to [\"api:read\"]" }
        },
        "required": ["client_id"]
      },
      "NewClientResponse": {
        "type": "object",
        "description": "The generated secret is returned only once.",
        "properties": {
          "client_id": { "type": "string" },
          "client_secret": { "type": "string" },
          "scopes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["client_id", "client_secret", "scopes"]
      },
      "UpdateClient": {
        "type": "object",
        "description": "At least one field must be present.",
        "properties": {
          "scopes": { "type": "array", "items": { "type": "string" } },
          "active": { "type": "boolean" }
        }
      },
      "CreatePublicClient": {
        "type": "object",
        "properties": {
          "client_id": { "type": "string" },
          "redirect_uri": { "type": "string", "format": "uri", "description": "Must be HTTPS, except loopback HTTP for local dev" },
          "scopes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["client_id", "redirect_uri"]
      },
      "Identity": {
        "type": "object",
        "properties": {
          "subject": { "type": "string" },
          "principal_type": { "type": "string", "enum": ["user", "service"] },
          "scopes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["subject", "principal_type", "scopes"]
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "token_type": { "type": "string", "example": "Bearer" },
          "expires_in": { "type": "integer", "format": "int64", "description": "Seconds" }
        },
        "required": ["access_token", "token_type", "expires_in"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Liveness probe",
        "responses": {
          "200": { "description": "Service is up", "content": { "text/plain": { "schema": { "type": "string", "example": "ok" } } } }
        }
      }
    },
    "/v1/verify": {
      "get": {
        "tags": ["Verify"],
        "summary": "Verify an access token",
        "description": "Verifies signature, issuer, audience, and expiration, then returns the subject, principal type, and scopes.",
        "security": [{ "accessToken": [] }],
        "responses": {
          "200": { "description": "Token is valid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Identity" } } } },
          "401": { "description": "Missing or invalid token" }
        }
      }
    },
    "/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "security": [{ "adminApiKey": [] }],
        "responses": {
          "200": { "description": "User list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/UserView" } } } } },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a user",
        "security": [{ "adminApiKey": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUser" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserView" } } } },
          "400": { "description": "Invalid email or password" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/v1/users/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["Users"],
        "summary": "Get a user",
        "security": [{ "adminApiKey": [] }],
        "responses": {
          "200": { "description": "User", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserView" } } } },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update a user",
        "security": [{ "adminApiKey": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateUser" } } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserView" } } } },
          "400": { "description": "No fields or invalid value" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" },
          "409": { "description": "Email already exists" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Deactivate a user",
        "description": "Deactivates the account; it does not delete account data.",
        "security": [{ "adminApiKey": [] }],
        "responses": {
          "204": { "description": "Deactivated" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/service-clients": {
      "get": {
        "tags": ["Service Clients"],
        "summary": "List service clients",
        "security": [{ "adminApiKey": [] }],
        "responses": {
          "200": { "description": "Client list", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ClientView" } } } } },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Service Clients"],
        "summary": "Create a service client",
        "description": "Returns the generated secret once. `scopes` defaults to [\"api:read\"].",
        "security": [{ "adminApiKey": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateClient" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewClientResponse" } } } },
          "400": { "description": "Invalid client_id or scopes" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "client_id already exists" }
        }
      }
    },
    "/v1/service-clients/{client_id}": {
      "parameters": [{ "name": "client_id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": {
        "tags": ["Service Clients"],
        "summary": "Update a service client",
        "security": [{ "adminApiKey": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateClient" } } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClientView" } } } },
          "400": { "description": "No fields present" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "tags": ["Service Clients"],
        "summary": "Deactivate a service client",
        "security": [{ "adminApiKey": [] }],
        "responses": {
          "204": { "description": "Deactivated" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/public-clients": {
      "post": {
        "tags": ["Public Clients"],
        "summary": "Register a PKCE public client",
        "security": [{ "adminApiKey": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePublicClient" } } } },
        "responses": {
          "201": { "description": "Registered" },
          "400": { "description": "Invalid redirect_uri or scopes" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "client_id already exists" }
        }
      }
    },
    "/oauth/authorize": {
      "get": {
        "tags": ["OAuth"],
        "summary": "Authorization page",
        "description": "Authorization Code + PKCE. Requires response_type=code, a non-empty state, and code_challenge_method=S256.",
        "parameters": [
          { "name": "response_type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["code", "token"] } },
          { "name": "client_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "redirect_uri", "in": "query", "required": true, "schema": { "type": "string", "format": "uri" } },
          { "name": "state", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "scope", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "code_challenge", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "code_challenge_method", "in": "query", "required": false, "schema": { "type": "string", "enum": ["S256"] } }
        ],
        "responses": {
          "200": { "description": "Login/consent HTML page", "content": { "text/html": {} } },
          "400": { "description": "Invalid request" }
        }
      },
      "post": {
        "tags": ["OAuth"],
        "summary": "Submit authorization (login + consent)",
        "requestBody": { "content": { "application/x-www-form-urlencoded": { "schema": { "type": "object" } } } },
        "responses": {
          "302": { "description": "Redirect to redirect_uri with code (or token fragment for implicit)" },
          "400": { "description": "Invalid request" },
          "401": { "description": "Bad credentials" }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "tags": ["OAuth"],
        "summary": "Token endpoint",
        "description": "Supports grant_type=authorization_code (PKCE) and grant_type=client_credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": { "type": "string", "enum": ["authorization_code", "client_credentials"] },
                  "client_id": { "type": "string" },
                  "client_secret": { "type": "string", "description": "client_credentials only" },
                  "redirect_uri": { "type": "string", "description": "authorization_code only" },
                  "code": { "type": "string", "description": "authorization_code only" },
                  "code_verifier": { "type": "string", "description": "authorization_code only" },
                  "scope": { "type": "string", "description": "client_credentials optional, space-separated" }
                },
                "required": ["grant_type", "client_id"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Access token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } } } },
          "400": { "description": "Invalid grant" },
          "401": { "description": "Invalid client credentials" }
        }
      }
    }
  }
}
