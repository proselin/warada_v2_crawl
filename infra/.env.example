# Create infra/.env from this file and replace every secret before starting.
POSTGRES_USER=warada
POSTGRES_DB=warada
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32

CRAWL_API_KEY=replace-with-a-random-secret
NETTRUYEN_URL=https://nettruyenar.com

AUTH_ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-bytes
AUTH_PASSWORD_PEPPER=replace-with-a-different-random-secret-at-least-32-bytes
JWT_SIGNING_KEY_ID=current
JWT_LEGACY_KEY_ID=current
JWT_ISSUER=http://localhost:8080/
JWT_AUDIENCE=warada-api
ACCESS_TOKEN_TTL_SECONDS=900

# Defaults to the crawler API; change this when a separate tools backend exists.
TOOLS_BACKEND_URL=http://crawler:3000
PUBLIC_BASE_URL=http://localhost:8080
