ARG PACKAGE
ARG BINARY

FROM rust:1-bookworm AS build
ARG PACKAGE
ARG BINARY
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --locked --release --package "$PACKAGE" --bin "$BINARY" \
    && test -x "/src/target/release/$BINARY"

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 sqlite3 \
    && rm -rf /var/lib/apt/lists/*
ARG BINARY
COPY --from=build /src/target/release/${BINARY} /usr/local/bin/service
ENTRYPOINT ["/usr/local/bin/service"]
